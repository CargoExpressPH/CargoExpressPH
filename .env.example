VITE_APP_URL=https://your-production-domain.example

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PHOTOS_BUCKET=cargo-photos

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
# Preferred shared client VAPID public key; the Firebase name remains a fallback.
VITE_VAPID_PUBLIC_KEY=your-firebase-web-push-vapid-key
VITE_FIREBASE_VAPID_KEY=your-firebase-web-push-vapid-key

VITE_PAYMONGO_PUBLIC_KEY=your-paymongo-public-key

# Public map tiles. The defaults use OpenStreetMap; use a production tile
# provider and its matching attribution for a higher-traffic deployment.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Local deployment/admin helper only. Do not expose this in browser builds.
supabase_PAT=your-supabase-personal-access-token
VERCEL_TOKEN=your-vercel-token
GITHUB_TOKEN=your-github-token

# Supabase Edge Function secrets, not Vite/browser env vars:
# PAYMONGO_SECRET_KEY
# PAYMONGO_WEBHOOK_SECRET
# FIREBASE_SERVICE_ACCOUNT_B64
# SUPABASE_SERVICE_ROLE_KEY
# CARGOEXPRESS_SUPABASE_PAT    - server-only PAT used by Photo Storage Monitoring
# VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY
# VAPID_SUBJECT
# RESEND_API_KEY              - broadcast-announcement; from resend.com/api-keys
# RESEND_FROM_EMAIL           - e.g. "CargoExpress PH <announcements@yourdomain.com>";
#                               must be on a domain verified in Resend
# UNSUBSCRIBE_SIGNING_SECRET  - any long random string; shared between
#                               broadcast-announcement and unsubscribe-announcements

# ── End-to-end test credentials ─────────────────────────────────────────
# Used only by the Playwright suite (`npm run test:e2e`). These used to live
# in a separate .env.test; they were folded in here on 2026-08-24 so the
# project has one local env file and one template.
#
# The E2E suite drives the REAL Supabase project configured above. It creates
# a trip, an announcement, a customer account and a booking on every run, and
# it does not clean up after itself. Point it at a development or staging
# project, not production.
#
# The admin account must already exist. The suite cannot create one:
# guard_profile_write forces every self-registered profile to role='customer',
# so an admin can only be minted with SQL or a service-role key.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=

# Optional — defaults to http://localhost:5173, which the Playwright config
# also starts via `npm run dev`. Set this to test against an already-running
# server or a deployed environment.
# E2E_BASE_URL=http://localhost:5173
